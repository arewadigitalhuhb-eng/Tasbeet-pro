# ============================================
# TASBEEH PRO - .gitignore
# ============================================

# ============================================
# DEPENDENCIES
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# BUILD OUTPUTS
# ============================================
dist/
build/
out/
.output/
.next/
.nuxt/
.vuepress/dist
.docusaurus/
.serverless/
.fusebox/
.dynamodb/

# ============================================
# ENVIRONMENT VARIABLES
# ============================================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.envrc

# ============================================
# IDE & EDITORS
# ============================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# WebStorm / IntelliJ
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
out/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Atom
.atom/

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
.\#*

# Eclipse
.project
.classpath
.settings/
.metadata/
*.tmp
*.bak
*.swp

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ============================================
# OS GENERATED FILES
# ============================================
# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon?
Icon\r
*.icloud

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# LOGS
# ============================================
logs/
*.log
*.log.*
log/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ============================================
# TESTING
# ============================================
coverage/
.nyc_output/
*.lcov
lib-cov/
jest/
__snapshots__/
*.snap
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/
*.test.js.snap

# ============================================
# TEMPORARY FILES
# ============================================
tmp/
temp/
*.tmp
*.temp
*.cache
.cache/
*.pid
*.seed
*.pid.lock
*.tgz
*.tar.gz
*.zip
*.rar
*.7z

# ============================================
